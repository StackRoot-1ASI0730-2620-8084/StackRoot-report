@startuml ClassDiagram_Matchmaking
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60
top to bottom direction

' Colores por tipo de componente para mejorar la legibilidad
skinparam class {
    BackgroundColor<<Interface>> #E3F2FD
    BackgroundColor<<AggregateRoot>> #FFF9C4
    BackgroundColor<<Entity>> #E8F5E9
    BackgroundColor #FAFAFA
    BorderColor #9E9E9E
    ArrowColor #424242
}
skinparam enum {
    BackgroundColor #F3E5F5
    BorderColor #9E9E9E
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
}

package "Trazza.API.MatchmakingContext" {
    
    ' Capa de Controladores (Presentación API)
    class MatchController {
        - _matchService: IMatchService
        + SuggestMatches(cargaId: int): ActionResult<List<MatchDto>>
        + AcceptMatch(matchId: int): ActionResult<bool>
    }

    ' Capa de Lógica de Negocio (Interfaces y Servicios)
    interface IMatchService <<Interface>> {
        + FindMatchesForCarga(cargaId: int): List<Match>
        + ConfirmMatch(matchId: int): bool
    }

    class MatchService {
        - _matchRepo: IMatchRepository
        - _osrmClient: IOsrmClient
        + FindMatchesForCarga(cargaId: int): List<Match>
        + ConfirmMatch(matchId: int): bool
        - CalculateCompatibility(ruta: RutaRetorno, carga: SolicitudCarga): float
    }

    ' Capa de Acceso a Datos (Interfaces y Repositorios)
    interface IMatchRepository <<Interface>> {
        + GetById(id: int): Match
        + GetAvailableRutas(): List<RutaRetorno>
        + Save(match: Match): void
    }

    class MatchRepository {
        - _dbContext: AppDbContext
        + GetById(id: int): Match
        + GetAvailableRutas(): List<RutaRetorno>
        + Save(match: Match): void
    }

    ' Capa de Dominio (Entidades y Agregados)
    class Match <<AggregateRoot>> {
        + Id: int
        + RutaId: int
        + CargaId: int
        + Status: MatchStatus
        + TarifaAcordada: decimal
        + ConfirmarAcuerdo(): void
        + CancelarAcuerdo(): void
    }

    class RutaRetorno <<Entity>> {
        + Id: int
        + TransportistaId: int
        + OrigenLatLon: string
        + DestinoLatLon: string
        + CapacidadDisponible: float
        + FechaSalida: DateTime
        + RestarCapacidad(peso: float): void
    }

    class SolicitudCarga <<Entity>> {
        + Id: int
        + EmprendedorId: int
        + OrigenLatLon: string
        + DestinoLatLon: string
        + PesoRequerido: float
        + IsAssigned: bool
        + MarcarComoAsignada(): void
    }
    
    enum MatchStatus {
        PENDING
        ACCEPTED
        REJECTED
    }
}

' Relaciones de Inyección de dependencias e Implementación
MatchController ..> IMatchService : usa
IMatchService <|.. MatchService : implementa
MatchService ..> IMatchRepository : usa
IMatchRepository <|.. MatchRepository : implementa

' Relaciones de uso con Entidades de Dominio
MatchService ..> Match : procesa
MatchRepository ..> Match : persiste

' Composiciones del Agregado
Match *-- RutaRetorno : vincula >
Match *-- SolicitudCarga : cubre >
Match *-right- MatchStatus : tiene estado >

@enduml